<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MiquiMundi — Mi Quiniela Mundialista 2026" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh">
    <% if signed_in? %>
      <nav class="flex items-center justify-between px-4 py-3 bg-slate-950/40 backdrop-blur border-b border-white/10 sticky top-0 z-40">
        <%= link_to quiniela_path, class: "flex items-center gap-2 font-display font-extrabold text-2xl text-white tracking-wide" do %>
          <%= image_tag "miquimundi-mark.png", width: 36, height: 36, alt: "", class: "w-9 h-9 rounded-lg ring-1 ring-white/15" %>
          MiquiMundi
        <% end %>
        <div class="flex gap-1 items-center">
          <%= link_to "Mi Quiniela", quiniela_path, class: "px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition #{'bg-white/15 text-white' if current_page?(quiniela_path)}" %>
          <%= link_to "Ranking", rankings_path, class: "px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition #{'bg-white/15 text-white' if current_page?(rankings_path)}" %>
          <%= button_to "Salir", session_path, method: :delete, class: "px-3 py-2 rounded-lg text-white/60 hover:text-white text-sm font-semibold transition" %>
        </div>
      </nav>
    <% end %>

    <% if flash.any? %>
      <div class="fixed top-4 inset-x-0 z-50 flex flex-col items-center gap-2 px-4 pointer-events-none">
        <% flash.each do |type, msg| %>
          <% alert = type.to_s == "alert" %>
          <div data-controller="flash" role="<%= alert ? 'alert' : 'status' %>" aria-live="polite"
               class="toast-in pointer-events-auto w-full max-w-md flex items-center gap-3 px-4 py-3 rounded-2xl shadow-2xl text-white font-semibold backdrop-blur ring-1
                      <%= alert ? 'bg-gradient-to-r from-rose-600/95 to-red-600/95 ring-rose-300/40' : 'bg-gradient-to-r from-emerald-600/95 to-green-600/95 ring-emerald-300/40' %>">
            <span class="text-xl shrink-0"><%= alert ? "⚠️" : "⚽" %></span>
            <span class="flex-1 leading-snug"><%= msg %></span>
            <button type="button" data-action="flash#dismiss" aria-label="Cerrar"
                    class="text-white/70 hover:text-white text-2xl leading-none cursor-pointer shrink-0">&times;</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main><%= yield %></main>
  </body>
</html>
