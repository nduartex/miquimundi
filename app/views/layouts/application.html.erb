<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MiquiMundi — Mi Quiniela Mundialista 2026" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh" data-controller="pitch-match">
    <% if signed_in? %>
      <nav data-controller="nav" aria-expanded="false" class="relative flex items-center justify-between px-4 py-3 bg-slate-950/40 backdrop-blur border-b border-white/10 sticky top-0 z-40">
        <%= link_to quiniela_path, class: "flex items-center gap-2 font-display font-extrabold text-lg sm:text-2xl text-white tracking-wide shrink-0" do %>
          <%= image_tag "miquimundi-mark.png", width: 36, height: 36, alt: "", class: "w-9 h-9 rounded-lg ring-1 ring-white/15" %>
          <span class="max-[420px]:hidden">MiquiMundi</span>
        <% end %>

        <%# Barra completa: sólo en sm+ donde hay espacio para todos los enlaces. %>
        <div class="hidden sm:flex gap-0.5 sm:gap-1 items-center shrink-0 text-sm sm:text-base">
          <%= link_to "Mi Quiniela", quiniela_path, class: "px-2.5 sm:px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition whitespace-nowrap #{'bg-white/15 text-white' if current_page?(quiniela_path)}" %>
          <%= link_to "Ranking", rankings_path, class: "px-2.5 sm:px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition whitespace-nowrap #{'bg-white/15 text-white' if current_page?(rankings_path)}" %>
          <%= link_to "Ligas", ligas_path, id: "nav-ligas", class: "px-2.5 sm:px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition whitespace-nowrap #{'bg-white/15 text-white' if current_page?(ligas_path)}" %>
          <%= link_to "Calendario", calendar_path, id: "nav-calendario", class: "px-2.5 sm:px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition whitespace-nowrap #{'bg-white/15 text-white' if current_page?(calendar_path)}" %>
          <%# En sm/md Posiciones/Goleadores viven como chips dentro de las páginas
              públicas (ver _live_nav); aquí sólo aparecen en md+. %>
          <%= link_to "Posiciones", standings_path, id: "nav-posiciones", class: "hidden md:inline-flex px-2.5 sm:px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition whitespace-nowrap #{'bg-white/15 text-white' if current_page?(standings_path)}" %>
          <%= link_to "Goleadores", scorers_path, id: "nav-goleadores", class: "hidden md:inline-flex px-2.5 sm:px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition whitespace-nowrap #{'bg-white/15 text-white' if current_page?(scorers_path)}" %>
          <%= link_to "Perfil", profile_path, class: "px-2.5 sm:px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition whitespace-nowrap #{'bg-white/15 text-white' if current_page?(profile_path)}" %>
          <%= link_to discord_invite_url, id: "nav-discord", target: "_blank", rel: "noopener noreferrer",
                title: "Únete al Discord", aria: { label: "Únete al Discord" },
                class: "px-2.5 sm:px-3 py-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition whitespace-nowrap inline-flex items-center gap-1.5" do %>
            <%= icon "discord", from: "custom", class: "size-5" %><span class="hidden lg:inline">Discord</span>
          <% end %>
          <%= button_to "Salir", session_path, method: :delete, class: "px-2.5 sm:px-3 py-2 rounded-lg text-white/60 hover:text-white text-sm font-semibold transition" %>
        </div>

        <%# En móvil: Salir siempre visible + botón hamburguesa que despliega el menú. %>
        <div class="flex sm:hidden items-center gap-1 shrink-0">
          <%= button_to "Salir", session_path, method: :delete, class: "px-2.5 py-2 rounded-lg text-white/60 hover:text-white text-sm font-semibold transition" %>
          <button type="button" data-action="nav#toggle" aria-label="Abrir menú"
                  class="p-2 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition inline-flex items-center justify-center">
            <%= icon "menu", data: { "nav-target": "open" }, class: "size-6" %>
            <%= icon "x", data: { "nav-target": "close" }, class: "size-6 hidden" %>
          </button>
        </div>

        <%# Panel desplegable (sólo móvil). %>
        <div data-nav-target="menu"
             class="hidden sm:hidden absolute top-full right-2 mt-1 w-56 max-w-[calc(100vw-1rem)] p-2 rounded-2xl bg-slate-950/95 backdrop-blur border border-white/10 shadow-2xl flex flex-col gap-0.5 z-50">
          <%= link_to "Mi Quiniela", quiniela_path, class: "block px-3 py-2.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition #{'bg-white/15 text-white' if current_page?(quiniela_path)}" %>
          <%= link_to "Ranking", rankings_path, class: "block px-3 py-2.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition #{'bg-white/15 text-white' if current_page?(rankings_path)}" %>
          <%= link_to "Ligas", ligas_path, class: "block px-3 py-2.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition #{'bg-white/15 text-white' if current_page?(ligas_path)}" %>
          <%= link_to "Calendario", calendar_path, class: "block px-3 py-2.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition #{'bg-white/15 text-white' if current_page?(calendar_path)}" %>
          <%= link_to "Perfil", profile_path, class: "block px-3 py-2.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition #{'bg-white/15 text-white' if current_page?(profile_path)}" %>
          <%= link_to discord_invite_url, target: "_blank", rel: "noopener noreferrer",
                class: "flex items-center gap-2 px-3 py-2.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 font-semibold transition" do %>
            <%= icon "discord", from: "custom", class: "size-5" %>Discord
          <% end %>
        </div>
      </nav>

      <%# Non-blocking nudge for users who haven't set a PIN yet. %>
      <% unless current_user.has_pin? %>
        <%= render "shared/pin_reminder" %>
      <% end %>
    <% end %>

    <% if flash.any? %>
      <div class="fixed top-4 inset-x-0 z-50 flex flex-col items-center gap-2 px-4 pointer-events-none">
        <% flash.each do |type, msg| %>
          <% alert = type.to_s == "alert" %>
          <div data-controller="flash" role="<%= alert ? 'alert' : 'status' %>" aria-live="polite"
               class="toast-in pointer-events-auto w-full max-w-md flex items-center gap-3 px-4 py-3 rounded-2xl shadow-2xl text-white font-semibold backdrop-blur ring-1 border-l-4
                      <%= alert ? 'bg-rose-900/90 ring-rose-300/30 border-rose-400' : 'bg-emerald-900/90 ring-emerald-300/30 border-emerald-400' %>">
            <span class="shrink-0 inline-flex"><%= alert ? icon("triangle-alert", class: "size-5") : icon("circle-check", class: "size-5") %></span>
            <span class="flex-1 leading-snug"><%= msg %></span>
            <button type="button" data-action="flash#dismiss" aria-label="Cerrar"
                    class="text-white/70 hover:text-white text-2xl leading-none cursor-pointer shrink-0">&times;</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main><%= yield %></main>
    <%= render "shared/footer" %>
  </body>
</html>
