<% content_for :title, "Calendario de Partidos — Mundial 2026" %>

<%
  phase_short = {
    "group" => nil,
    "round_32" => "Dieciseisavos",
    "round_16" => "Octavos",
    "quarter" => "Cuartos",
    "semi" => "Semifinal",
    "third_place" => "Tercer puesto",
    "final" => "Final"
  }
%>

<main class="max-w-3xl mx-auto px-4 py-6 sm:py-10" data-controller="local-time calendar">
  <header class="mb-6">
    <h1 class="font-display font-extrabold text-2xl sm:text-3xl text-white tracking-wide">
      Calendario de Partidos
    </h1>
    <p class="text-white/60 mt-1 text-sm sm:text-base">Copa Mundial de la FIFA 2026</p>

    <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-emerald-500/10 ring-1 ring-emerald-400/25 px-3 py-1.5 text-sm text-emerald-200">
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      Horarios en tu zona:
      <span class="font-semibold" data-local-time-target="zone">tu hora local</span>
    </p>
    <%= render "shared/live_nav" %>
  </header>

  <% @days.each do |day| %>
    <% focus = day[:date] == @focus_date %>
    <% is_today = day[:date] == @today %>
    <section id="day-<%= day[:date] %>" class="mb-7 scroll-mt-4"
             <%= "data-calendar-target=today".html_safe if focus %>>
      <div class="surface surface-neon p-5 <%= "ring-2 ring-amber-300/70" if is_today %>">
      <h2 class="flex items-center gap-2 mb-4 pb-3 border-b border-white/10 text-sm font-semibold uppercase tracking-wider text-amber-200/90">
        <svg class="w-4 h-4 shrink-0 text-amber-300/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>
        <%= day[:label] %>
        <% if is_today %>
          <span class="ml-auto text-[11px] font-bold uppercase tracking-wider text-amber-300 bg-amber-500/15 ring-1 ring-amber-400/30 rounded-full px-2 py-0.5">Hoy</span>
        <% end %>
      </h2>
      <ul class="space-y-2.5">
        <% day[:matches].each do |m| %>
          <% knockout = m["home"].blank? %>
          <% rec = m["record"] %>
          <% live = rec&.status == "live" %>
          <% finished = rec&.status == "finished" %>
          <li class="rounded-xl bg-white/[0.04] ring-1 ring-white/10 p-3.5 sm:p-4 hover:bg-white/[0.07] transition">
            <div class="flex items-center justify-between gap-3">
              <span class="flex items-center gap-1.5 min-w-0">
                <% if knockout %>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-amber-300/90 bg-amber-500/10 ring-1 ring-amber-400/20 rounded px-1.5 py-0.5">
                    <%= phase_short[m["phase"]] %>
                  </span>
                  <span class="text-[11px] font-semibold text-white/40">Partido <%= m["match_number"] %></span>
                <% else %>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-300/90 bg-indigo-500/10 ring-1 ring-indigo-400/20 rounded px-1.5 py-0.5">
                    Grupo <%= m["group"] %>
                  </span>
                <% end %>
                <% if live %>
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-emerald-300 bg-emerald-500/10 ring-1 ring-emerald-400/25 rounded-full px-2 py-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> En vivo
                  </span>
                <% elsif finished %>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-white/50 bg-white/5 ring-1 ring-white/15 rounded-full px-2 py-0.5">Final</span>
                <% end %>
              </span>

              <% if m["kickoff_utc"].present? %>
                <time datetime="<%= m["kickoff_utc"] %>"
                      data-local-time-target="time"
                      data-utc="<%= m["kickoff_utc"] %>"
                      class="tabular-nums font-semibold text-white/90 text-sm">
                  <%= m["kickoff_utc"] %>
                </time>
              <% else %>
                <span class="text-white/40 text-xs italic">Hora por confirmar</span>
              <% end %>
            </div>

            <% if knockout && !(rec&.home_team && rec&.away_team) %>
              <div class="mt-2.5 text-center">
                <span class="font-semibold text-white/90"><%= m["home_label"] %></span>
                <span class="text-white/40 text-xs font-bold px-2">vs</span>
                <span class="font-semibold text-white/90"><%= m["away_label"] %></span>
              </div>
            <% else %>
              <% home_name = knockout ? rec.home_team.name : m["home"]["name"] %>
              <% away_name = knockout ? rec.away_team.name : m["away"]["name"] %>
              <% home_flag = knockout ? rec.home_team.flag_url : (m["home"]["flag_url"] || "https://flagcdn.com/w80/#{m["home"]["iso2"]}.png") %>
              <% away_flag = knockout ? rec.away_team.flag_url : (m["away"]["flag_url"] || "https://flagcdn.com/w80/#{m["away"]["iso2"]}.png") %>
              <div class="mt-2.5 grid grid-cols-[1fr_auto_1fr] items-center gap-2 sm:gap-3">
                <div class="flex items-center justify-end gap-2 min-w-0">
                  <span class="font-semibold text-white truncate text-right"><%= home_name %></span>
                  <% if home_flag %>
                    <img src="<%= home_flag %>" alt="" width="28" height="21" loading="lazy"
                         class="w-7 h-[21px] rounded-sm object-cover ring-1 ring-white/15 shrink-0">
                  <% end %>
                </div>

                <% if rec && rec.status != "scheduled" && rec.home_goals %>
                  <span class="tabular-nums font-extrabold text-base px-1 <%= live ? "text-emerald-300" : "text-white" %>">
                    <%= rec.home_goals %>–<%= rec.away_goals %>
                  </span>
                <% else %>
                  <span class="text-white/40 text-xs font-bold px-1">vs</span>
                <% end %>

                <div class="flex items-center gap-2 min-w-0">
                  <% if away_flag %>
                    <img src="<%= away_flag %>" alt="" width="28" height="21" loading="lazy"
                         class="w-7 h-[21px] rounded-sm object-cover ring-1 ring-white/15 shrink-0">
                  <% end %>
                  <span class="font-semibold text-white truncate"><%= away_name %></span>
                </div>
              </div>

              <% if rec&.penalty_winner_id %>
                <p class="mt-1 text-center text-xs text-amber-300/90 font-semibold">
                  <%= rec.penalty_winner_id == rec.home_team_id ? home_name : away_name %> gana en penales
                </p>
              <% end %>

              <% goals = rec ? rec.goals.sort_by(&:sort_order) : [] %>
              <% if goals.any? %>
                <div class="mt-2 grid grid-cols-2 gap-x-5 text-xs text-white/55">
                  <ul class="space-y-0.5 text-right">
                    <% goals.select { |g| g.team_id == rec.home_team_id }.each do |g| %>
                      <li><%= g.minute %> <%= g.player_name %><%= " (pen)" if g.penalty %><%= " (AG)" if g.own_goal %> <span aria-hidden="true">⚽</span></li>
                    <% end %>
                  </ul>
                  <ul class="space-y-0.5">
                    <% goals.select { |g| g.team_id == rec.away_team_id }.each do |g| %>
                      <li><span aria-hidden="true">⚽</span> <%= g.minute %> <%= g.player_name %><%= " (pen)" if g.penalty %><%= " (AG)" if g.own_goal %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            <% end %>

            <p class="mt-2.5 flex items-center gap-1.5 text-white/50 text-xs">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10Z"/><circle cx="12" cy="11" r="2"/></svg>
              <%= m["venue"] %>
            </p>
          </li>
        <% end %>
      </ul>
      </div>
    </section>
  <% end %>
</main>
