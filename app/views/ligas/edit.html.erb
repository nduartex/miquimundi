<div class="max-w-md mx-auto px-4 py-8">
  <header class="mb-6">
    <h1 class="font-display text-3xl font-extrabold text-white flex items-center gap-2"><%= icon "square-pen", class: "size-7" %> Editar liga</h1>
    <p class="text-white/60 mt-1">Cambia el nombre o el cupo. El cupo no puede bajar de los <%= @liga.memberships.count %> jugadores actuales.</p>
  </header>

  <%= render "form", liga: @liga, submit_label: "Guardar cambios", cancel_path: liga_path(@liga) %>
</div>
