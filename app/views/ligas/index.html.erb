<div class="max-w-2xl mx-auto px-4 py-8">
  <header class="mb-6">
    <h1 class="font-display text-4xl font-extrabold text-white flex items-center gap-2"><%= icon "handshake", class: "size-8 text-emerald-300" %> Ligas</h1>
    <p class="text-white/60 mt-1">Compite en un ranking privado con tus amigos. Mismos puntos que el ranking global.</p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2 mb-8">
    <%= link_to new_liga_path, class: "surface surface-neon p-5 flex items-center gap-3 hover:bg-white/5 transition" do %>
      <span class="shrink-0 text-emerald-300"><%= icon "plus", class: "size-8" %></span>
      <div class="min-w-0">
        <div class="font-display font-extrabold text-white text-lg leading-tight">Crear liga</div>
        <div class="text-white/50 text-xs">Tú eres el creador</div>
      </div>
    <% end %>

    <%= form_with url: join_ligas_path, method: :post, class: "surface p-5 flex flex-col gap-2" do |f| %>
      <%= f.label :invite_code, "Unirme con código", class: "block text-white/70 text-xs uppercase tracking-wide" %>
      <div class="flex gap-2">
        <%= f.text_field :invite_code, placeholder: "ABC234", maxlength: 6, autocomplete: "off",
              class: "field uppercase tracking-[0.3em] font-display font-bold flex-1 min-w-0" %>
        <%= f.submit "Unirme", class: "btn-sky shrink-0 px-4 py-3" %>
      </div>
    <% end %>
  </div>

  <h2 class="font-display text-xl font-bold text-white/90 mb-3">Mis ligas</h2>
  <% if @ligas.empty? %>
    <div class="surface p-10 text-center">
      <div class="mb-3 flex justify-center"><%= icon "clipboard-list", class: "size-12 text-white/70" %></div>
      <p class="text-white/80 font-semibold">Todavía no estás en ninguna liga.</p>
      <p class="text-white/50 text-sm mt-1">Crea una o únete con un código.</p>
    </div>
  <% else %>
    <div class="space-y-3">
      <% @ligas.each do |liga| %>
        <%= link_to liga, class: "surface p-4 flex items-center gap-3 hover:bg-white/5 transition" do %>
          <span class="shrink-0 text-amber-300"><%= icon "medal", class: "size-7" %></span>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 min-w-0">
              <div class="text-white font-display font-bold text-lg truncate leading-tight"><%= liga.name %></div>
              <% if liga.has_prize? %>
                <span class="shrink-0 text-amber-300 inline-flex" title="Liga con premio"><%= icon "coins", class: "size-4" %></span>
              <% end %>
            </div>
            <div class="text-white/50 text-sm mt-0.5 inline-flex items-center gap-1"><%= icon "users", class: "size-4" %> <%= liga.memberships.size %>/<%= liga.max_players %> jugadores</div>
          </div>
          <% if liga.creator?(current_user) %>
            <span class="chip shrink-0"><%= icon "crown", class: "size-3.5" %> Tú</span>
          <% end %>
          <span class="text-white/30 text-2xl shrink-0 leading-none">›</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
