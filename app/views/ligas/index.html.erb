<div class="max-w-2xl mx-auto px-4 py-8">
  <header class="mb-6">
    <h1 class="font-display text-4xl font-extrabold text-white">🤝 Ligas</h1>
    <p class="text-white/60 mt-1">Compite en un ranking privado con tus amigos. Mismos puntos que el ranking global.</p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2 mb-8">
    <%= link_to new_liga_path, class: "surface p-5 flex items-center gap-3 hover:bg-white/10 transition" do %>
      <span class="text-3xl">➕</span>
      <span class="font-display font-bold text-white text-lg">Crear liga</span>
    <% end %>

    <%= form_with url: join_ligas_path, method: :post, class: "surface p-5 flex flex-col gap-2" do |f| %>
      <label class="text-white/70 text-sm font-semibold">Unirme con código</label>
      <div class="flex gap-2">
        <%= f.text_field :invite_code, placeholder: "ABC234", maxlength: 6, autocomplete: "off",
              class: "flex-1 min-w-0 rounded-lg bg-slate-900/60 ring-1 ring-white/15 px-3 py-2 text-white uppercase tracking-widest font-mono" %>
        <%= f.submit "Unirme", class: "shrink-0 rounded-lg bg-emerald-500 hover:bg-emerald-400 px-4 py-2 font-semibold text-white cursor-pointer transition" %>
      </div>
    <% end %>
  </div>

  <h2 class="font-display text-xl font-bold text-white/90 mb-3">Mis ligas</h2>
  <% if @ligas.empty? %>
    <div class="surface p-10 text-center">
      <div class="text-5xl mb-3">📋</div>
      <p class="text-white/80 font-semibold">Todavía no estás en ninguna liga.</p>
      <p class="text-white/50 text-sm mt-1">Crea una o únete con un código.</p>
    </div>
  <% else %>
    <div class="space-y-3">
      <% @ligas.each do |liga| %>
        <%= link_to liga, class: "surface p-4 flex items-center justify-between gap-3 hover:bg-white/10 transition" do %>
          <div class="min-w-0">
            <div class="text-white font-semibold truncate"><%= liga.name %></div>
            <div class="text-white/50 text-sm"><%= liga.memberships.count %>/<%= liga.max_players %> jugadores</div>
          </div>
          <% if liga.creator?(current_user) %>
            <span class="shrink-0 text-amber-300 text-xs font-bold uppercase tracking-widest">👑 Tú</span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
