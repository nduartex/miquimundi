<% leader = quinielas.first&.total_points || 0 %>
<% if quinielas.empty? %>
  <div class="surface p-10 text-center">
    <div class="text-5xl mb-3">📋</div>
    <p class="text-white/80 font-semibold">Aún no hay participantes.</p>
    <p class="text-white/50 text-sm mt-1">Sé el primero en armar tu quiniela.</p>
  </div>
<% else %>
  <div class="space-y-2">
    <% quinielas.each_with_index do |q, i| %>
      <% medal = ["🥇", "🥈", "🥉"][i] %>
      <div class="flex items-center gap-3 surface p-3 <%= 'ring-2 ring-amber-300' if i.zero? %>">
        <span class="w-9 text-center font-display font-extrabold text-lg <%= i.zero? ? 'text-amber-300' : 'text-white/80' %>">
          <%= medal || (i + 1) %>
        </span>
        <span class="flex-1 text-white font-semibold truncate"><%= q.user.display_name %></span>
        <span class="text-emerald-300 text-sm font-semibold tabular-nums" title="Aciertos exactos"><%= q.exact_hits %>✓</span>
        <span class="text-rose-300 text-sm font-semibold tabular-nums" title="Partidos acertados"><%= q.match_hits %>⚽</span>
        <span class="text-amber-300 font-display font-extrabold text-xl w-14 text-right tabular-nums"><%= q.total_points %></span>
        <span class="text-white/45 text-xs w-12 text-right tabular-nums"><%= i.zero? ? "—" : "-#{leader - q.total_points}" %></span>
      </div>
    <% end %>
  </div>
<% end %>
