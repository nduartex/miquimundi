<div class="min-h-dvh flex items-center justify-center px-4">
  <div class="w-full max-w-md surface p-8 hero-in">
    <div class="relative flex justify-center mb-5">
      <div class="hero-glow" aria-hidden="true"></div>
      <%= image_tag "miquimundi.jpg", width: 224, height: 224, fetchpriority: "high",
            alt: "MiquiMundi — Mi Quiniela Mundialista 2026",
            class: "relative z-10 w-56 h-56 rounded-2xl shadow-2xl ring-1 ring-white/15" %>
    </div>
    <h1 class="sr-only">MiquiMundi — Mi Quiniela Mundialista 2026</h1>

    <p class="text-center text-white text-lg font-semibold leading-snug mb-5">
      Arma tu quiniela y compite con tus amigos:<br>
      <span class="text-amber-300">¿quién acierta más? 🏆</span>
    </p>

    <%# Countdown to the opening match (11 Jun 2026) %>
    <div data-controller="countdown" data-countdown-target-value="2026-06-11T18:00:00Z" class="mb-6">
      <p class="text-center text-white/50 text-xs uppercase tracking-wide mb-2">Arranca el Mundial en</p>
      <div class="grid grid-cols-4 gap-2 text-center" data-countdown-target="grid">
        <% [["días", "days"], ["hrs", "hours"], ["min", "mins"], ["seg", "secs"]].each do |label, target| %>
          <div class="surface-soft py-2">
            <div class="text-2xl font-display font-extrabold text-amber-300 tabular-nums" data-countdown-target="<%= target %>">--</div>
            <div class="text-[10px] uppercase tracking-wide text-white/50"><%= label %></div>
          </div>
        <% end %>
      </div>
      <p class="hidden text-center text-amber-300 font-bold" data-countdown-target="done">¡El Mundial ya comenzó! ⚽</p>
    </div>

    <%= form_with url: session_path, method: :post, class: "space-y-4" do |f| %>
      <label class="block text-white/70 text-xs uppercase tracking-wide mb-1" for="email">Tu correo</label>
      <%= f.email_field :email, id: "email", required: true, autocomplete: "email", placeholder: "tu@correo.com",
            class: "field text-lg" %>
      <%= f.submit "Entrar a jugar",
            class: "w-full bg-gradient-to-r from-amber-400 to-rose-500 text-slate-900 font-extrabold py-3.5 rounded-xl text-lg hover:brightness-110 transition cursor-pointer" %>
    <% end %>
    <p class="text-white/40 text-xs text-center mt-6">Sin contraseña. Tu correo es tu identificador.</p>
  </div>
</div>
