<div class="min-h-dvh flex items-center justify-center px-4">
  <div class="w-full max-w-md surface p-8 hero-in">
    <div class="relative flex justify-center mb-5">
      <div class="hero-glow" aria-hidden="true"></div>
      <%= image_tag "miquimundi.jpg", width: 224, height: 224, fetchpriority: "high",
            alt: "MiquiMundi — Mi Quiniela Mundialista 2026",
            class: "relative z-10 w-56 h-56 rounded-2xl shadow-2xl ring-1 ring-white/15" %>
    </div>
    <h1 class="sr-only">MiquiMundi — Mi Quiniela Mundialista 2026</h1>

    <p class="text-center text-white text-lg font-semibold leading-snug mb-5">
      Arma tu quiniela y compite con tus amigos<br>
      <span class="text-amber-300">¿Quién acierta más? 🏆</span>
    </p>

    <%# Countdown to the opening match (11 Jun 2026) %>
    <div data-controller="countdown" data-countdown-target-value="2026-06-11T18:00:00Z" class="mb-6">
      <p class="text-center text-white/50 text-xs uppercase tracking-wide mb-2">Arranca el Mundial en</p>
      <div class="grid grid-cols-4 gap-2 text-center" data-countdown-target="grid">
        <% [["días", "days"], ["hrs", "hours"], ["min", "mins"], ["seg", "secs"]].each do |label, target| %>
          <div class="surface-soft py-2">
            <div class="text-2xl font-display font-extrabold text-amber-300 tabular-nums" data-countdown-target="<%= target %>">--</div>
            <div class="text-[10px] uppercase tracking-wide text-white/50"><%= label %></div>
          </div>
        <% end %>
      </div>
      <p class="hidden text-center text-amber-300 font-bold" data-countdown-target="done">¡El Mundial ya comenzó! ⚽</p>
    </div>

    <%= form_with url: session_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-white/70 text-xs uppercase tracking-wide mb-1" for="username">Elige tu nombre de usuario</label>
        <%= text_field_tag :username, params[:username], id: "username", required: true, autocomplete: "off",
              minlength: 5, maxlength: 20, placeholder: "ej: martin_10",
              class: "field text-lg" %>
        <p class="text-white/40 text-xs mt-1">5 a 20 caracteres (letras, números o símbolos). Debe ser único.</p>
      </div>

      <% if @tournament %>
        <script type="application/json" id="teams-json"><%== teams_dataset(@tournament).to_json %></script>
        <div data-controller="combobox" data-combobox-dataset-id-value="teams-json" class="relative">
          <label class="block text-white/70 text-xs uppercase tracking-wide mb-1">Elige tu selección favorita <span class="text-white/40 normal-case">(opcional)</span></label>
          <%= hidden_field_tag "favorite_team_id", nil, data: { combobox_target: "hidden" } %>
          <input type="text" data-combobox-target="input" autocomplete="off" placeholder="Tu equipo del alma…"
                 data-action="input->combobox#filter focus->combobox#filter keydown->combobox#key blur->combobox#blur"
                 class="field">
          <ul data-combobox-target="list" role="listbox" hidden
              class="absolute z-30 mt-1 w-full max-h-60 overflow-auto rounded-xl bg-pitch-800 border border-chalk/25 shadow-2xl py-1"></ul>
        </div>
      <% end %>

      <%= f.submit "⚽ Entrar a la cancha",
            class: "btn-primary w-full text-lg py-3.5" %>
    <% end %>
    <p class="text-white/40 text-xs text-center mt-6">Sin contraseña. Tras crear tu usuario te daremos un <strong class="text-white/60">enlace de acceso</strong> para volver a entrar. ¿Ya tienes uno? Úsalo para reingresar.</p>
  </div>
</div>
