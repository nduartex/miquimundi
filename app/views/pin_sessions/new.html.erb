<div class="min-h-dvh flex items-center justify-center px-4">
  <div class="w-full max-w-md surface p-8 hero-in">
    <div class="relative flex justify-center mb-5">
      <div class="hero-glow" aria-hidden="true"></div>
      <%= image_tag "miquimundi.jpg", width: 160, height: 160, fetchpriority: "high",
            alt: "MiquiMundi — Mi Quiniela Mundialista 2026",
            class: "relative z-10 w-40 h-40 rounded-2xl shadow-2xl ring-1 ring-white/15" %>
    </div>
    <h1 class="text-center text-white text-xl font-display font-extrabold mb-1">Entrar con tu PIN</h1>
    <p class="text-center text-white/50 text-sm mb-6">Usa tu nombre de usuario y tu PIN de 8 dígitos.</p>

    <%= form_with url: pin_session_path, method: :post, class: "space-y-4" do %>
      <div>
        <label class="block text-white/70 text-xs uppercase tracking-wide mb-1" for="username">Nombre de usuario</label>
        <%= text_field_tag :username, params[:username], id: "username", required: true, autocomplete: "username",
              class: "field text-lg" %>
      </div>

      <div>
        <label class="block text-white/70 text-xs uppercase tracking-wide mb-1" for="pin">PIN</label>
        <%= password_field_tag :pin, nil, id: "pin", required: true, autocomplete: "current-password",
              inputmode: "numeric", pattern: "\\d{8}", minlength: 8, maxlength: 8,
              placeholder: "8 dígitos", class: "field text-lg tracking-[0.4em]" %>
      </div>

      <%= submit_tag "Entrar", data: { turbo_submits_with: "Entrando…" },
            class: "btn-primary w-full text-lg py-3.5" %>
    <% end %>

    <p class="text-white/40 text-xs text-center mt-6">
      ¿Olvidaste tu PIN? Entra con tu <strong class="text-white/60">enlace de acceso</strong> y créalo de nuevo desde tu perfil.
    </p>
    <p class="text-white/40 text-xs text-center mt-3">
      ¿No tienes cuenta? <%= link_to "Crear usuario", new_session_path, class: "text-amber-300 font-semibold hover:underline" %>
    </p>
  </div>
</div>
