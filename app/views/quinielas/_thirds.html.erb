<% thirds_by_group = locked ? quiniela.group_predictions.includes(:third_team).index_by(&:group_id) : {} %>
<div data-controller="thirds"
     data-thirds-teams-value="<%= teams_json %>"
     data-thirds-groups-value="<%= groups_json %>"
     data-thirds-locked-value="<%= locked %>"
     data-thirds-max-value="8">
  <div class="flex items-center justify-between mb-4">
    <p class="text-white/70 pr-3">Elige los <strong class="text-white">8 mejores terceros</strong> que clasifican a dieciseisavos.</p>
    <span class="hidden sm:inline-block shrink-0 px-3 py-1 rounded-full bg-amber-400 text-slate-900 font-extrabold tabular-nums" data-thirds-target="counter">0/8</span>
  </div>

  <%# Mobile only: a counter pinned just below the top nav while you scroll the
      12 groups, so you always see how many thirds you've picked. %>
  <div class="sm:hidden sticky top-16 z-30 mb-3 flex justify-end pointer-events-none">
    <span class="pointer-events-auto px-3 py-1 rounded-full bg-amber-400 text-slate-900 font-extrabold tabular-nums shadow-lg shadow-black/40" data-thirds-target="counter">0/8</span>
  </div>

  <div class="grid sm:grid-cols-2 gap-2">
    <% groups.each do |group| %>
      <label data-thirds-target="option" data-group="<%= group.name %>"
             class="surface-soft flex items-center gap-3 px-3 py-3 cursor-pointer transition ring-amber-300">
        <input type="checkbox" name="best_third_groups[]" value="<%= group.name %>"
               data-thirds-target="checkbox" data-action="thirds#change"
               <%= "checked" if Array(quiniela.best_third_groups).include?(group.name) %>
               <%= "disabled" if locked %>
               class="w-5 h-5 accent-amber-400 shrink-0 <%= 'cursor-not-allowed' if locked %>">
        <span class="w-9 h-8 rounded-lg bg-white/10 text-white/80 text-xs font-extrabold flex items-center justify-center shrink-0">3º<%= group.name %></span>
        <span class="flex-1 min-w-0 text-white font-semibold truncate" data-team><%
          # When locked there are no group-order hidden fields for the JS to read,
          # so render the 3rd-place team server-side. Live (unlocked) pages keep
          # "—" and let the thirds controller fill it reactively.
          third = thirds_by_group[group.id]&.third_team if locked %><% if third %><span class="inline-flex items-center gap-1.5"><% if third.flag_url %><img src="<%= third.flag_url %>" alt="" class="w-[22px] h-[16px] rounded-sm object-cover ring-1 ring-white/15"><% end %><span><%= third.name %></span></span><% else %>—<% end %></span>
      </label>
    <% end %>
  </div>

  <p class="text-white/40 text-xs mt-3">El 3º de cada grupo sale de tu orden del paso anterior. Los 4 que no elijas quedan eliminados.</p>
</div>
