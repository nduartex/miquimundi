<p class="text-white/70 mb-4">Ordena los <strong class="text-white">4 equipos</strong> de cada grupo arrastrándolos. El 1º y 2º clasifican y suman puntos; el orden completo alimenta tu bracket.</p>
<div class="grid sm:grid-cols-2 gap-4">
  <% groups.each do |group| %>
    <% gp = quiniela.group_predictions.find_by(group_id: group.id) %>
    <% ranked_ids = gp&.ranked_team_ids || [] %>
    <% ordered = (ranked_ids.map { |id| group.teams.detect { |t| t.id == id } }.compact + (group.teams.to_a - group.teams.select { |t| ranked_ids.include?(t.id) })).first(4) %>
    <div class="surface p-5">
      <h3 class="font-display text-xl font-bold text-white mb-3 flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-amber-400 text-slate-900 font-extrabold"><%= group.name %></span>
        Grupo <%= group.name %>
      </h3>

      <div data-controller="group-order">
        <%# hidden inputs 1st..4th, kept in sync by the controller %>
        <% %w[first second third fourth].each_with_index do |slot, i| %>
          <%= hidden_field_tag "group_predictions[#{group.id}][#{slot}_team_id]", ordered[i]&.id,
                data: { group_order_target: "hidden" } %>
        <% end %>

        <ul data-group-order-target="list" class="space-y-2">
          <% ordered.each_with_index do |team, i| %>
            <li data-group-order-target="item" data-team-id="<%= team.id %>" draggable="true"
                data-action="dragstart->group-order#dragStart dragend->group-order#dragEnd dragover->group-order#dragOver drop->group-order#drop"
                class="flex items-center gap-3 rounded-xl bg-slate-800/80 border border-white/15 px-3 py-2.5 cursor-grab active:cursor-grabbing">
              <span class="w-6 h-6 rounded-md bg-white/10 text-white/80 text-sm font-extrabold flex items-center justify-center shrink-0" data-pos><%= i + 1 %></span>
              <% if team.flag_url %>
                <img src="<%= team.flag_url %>" alt="" width="26" height="20" loading="lazy"
                     class="w-[26px] h-[20px] rounded-sm object-cover ring-1 ring-white/15 shrink-0">
              <% end %>
              <span class="flex-1 text-white font-semibold truncate"><%= team.name %></span>
              <span class="text-white/30 text-lg select-none" aria-hidden="true">⠿</span>
            </li>
          <% end %>
        </ul>
        <p class="text-white/40 text-xs mt-2"><span class="text-emerald-300 font-semibold">1º-2º</span> clasifican · <span class="text-white/60">3º</span> candidato a mejor tercero</p>
      </div>
    </div>
  <% end %>
</div>
