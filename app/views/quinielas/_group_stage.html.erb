<p class="text-white/70 mb-4">Elige los <strong class="text-white">2 clasificados</strong> de cada grupo. Aciertas el orden exacto y sumas bonus.</p>
<div class="grid sm:grid-cols-2 gap-4">
  <% groups.each do |group| %>
    <% gp = quiniela.group_predictions.find_by(group_id: group.id) %>
    <div class="surface p-5">
      <h3 class="font-display text-xl font-bold text-white mb-3 flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-amber-400 text-slate-900 font-extrabold"><%= group.name %></span>
        Grupo <%= group.name %>
      </h3>
      <label class="block text-white/70 text-xs uppercase tracking-wide mb-1">1º clasificado</label>
      <div class="mb-3">
        <%= render "flag_select", name: "group_predictions[#{group.id}][first_team_id]",
              teams: group.teams, selected_id: gp&.first_team_id, placeholder: "Selecciona…" %>
      </div>
      <label class="block text-white/70 text-xs uppercase tracking-wide mb-1">2º clasificado</label>
      <%= render "flag_select", name: "group_predictions[#{group.id}][second_team_id]",
            teams: group.teams, selected_id: gp&.second_team_id, placeholder: "Selecciona…" %>
    </div>
  <% end %>
</div>
