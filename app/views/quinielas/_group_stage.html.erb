<% # Per-rank accent: 1º-2º grass (clasifican), 3º gold (candidato), 4º muted.
   row_accents = ["var(--color-grass)", "var(--color-grass)", "var(--color-gold)", "#9fb3a6"] %>
<p class="text-white/70 mb-4">
  <% if locked %>Tu orden de grupos quedó <strong class="text-white">cerrado</strong>. El 1º y 2º clasifican; el 3º es candidato a mejor tercero.
  <% else %>Ordena los <strong class="text-white">4 equipos</strong> de cada grupo arrastrándolos. El 1º y 2º clasifican y suman puntos; el orden completo alimenta tu bracket.<% end %>
</p>
<div class="grid sm:grid-cols-2 gap-4">
  <% groups.each do |group| %>
    <% gp = quiniela.group_predictions.find_by(group_id: group.id) %>
    <% ranked_ids = gp&.ranked_team_ids || [] %>
    <% ordered = (ranked_ids.map { |id| group.teams.detect { |t| t.id == id } }.compact + (group.teams.to_a - group.teams.select { |t| ranked_ids.include?(t.id) })).first(4) %>
    <div class="surface surface-neon p-5">
      <h3 class="mb-3">
        <span class="badge-group inline-flex items-center rounded-lg font-display font-extrabold text-lg px-3 py-1">Grupo <%= group.name %></span>
      </h3>

      <div <%= 'data-controller="group-order"'.html_safe unless locked %>>
        <% unless locked %>
          <% %w[first second third fourth].each_with_index do |slot, i| %>
            <%= hidden_field_tag "group_predictions[#{group.id}][#{slot}_team_id]", ordered[i]&.id,
                  data: { group_order_target: "hidden" } %>
          <% end %>
        <% end %>

        <ul <%= 'data-group-order-target="list"'.html_safe unless locked %> class="space-y-2 <%= 'opacity-80' if locked %>">
          <% ordered.each_with_index do |team, i| %>
            <li <% unless locked %>data-group-order-target="item" data-team-id="<%= team.id %>" draggable="true"
                data-action="dragstart->group-order#dragStart dragend->group-order#dragEnd dragover->group-order#dragOver drop->group-order#drop"<% end %>
                style="--accent: <%= row_accents[i] || row_accents.last %>"
                class="team-row <%= 'is-out' if i == 3 %> flex items-center gap-3 px-3 py-2.5 <%= locked ? 'cursor-default' : 'cursor-grab active:cursor-grabbing' %>">
              <span class="w-6 h-6 rounded-md text-sm font-extrabold flex items-center justify-center shrink-0" data-pos><%= i + 1 %></span>
              <% if team.flag_url %>
                <img src="<%= team.flag_url %>" alt="" width="26" height="20" loading="lazy"
                     class="w-[26px] h-[20px] rounded-sm object-cover ring-1 ring-white/15 shrink-0">
              <% end %>
              <span class="flex-1 text-white font-semibold truncate"><%= team.name %></span>
              <span class="text-white/30 text-lg select-none" aria-hidden="true"><%= locked ? "🔒" : "⠿" %></span>
            </li>
          <% end %>
        </ul>
        <p class="text-white/40 text-xs mt-2"><span class="text-emerald-300 font-semibold">1º-2º</span> clasifican · <span class="text-white/60">3º</span> candidato a mejor tercero</p>
      </div>
    </div>
  <% end %>
</div>
