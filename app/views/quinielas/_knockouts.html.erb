<% unless open %>
  <div class="surface p-8 text-center">
    <div class="mb-3 flex justify-center"><%= icon "lock", class: "size-12 text-white/70" %></div>
    <h3 class="font-display text-2xl font-bold text-white mb-2">Eliminatorias bloqueadas</h3>
    <p class="text-white/70 max-w-md mx-auto">Se desbloquea cuando termine la <strong class="text-white">fase de grupos</strong>. Ahí se generan los partidos reales de dieciseisavos y podrás predecir los marcadores contra los equipos clasificados.</p>
    <p class="text-white/40 text-sm mt-4">Por ahora completa tus grupos, los 8 mejores terceros y tus premios. 💪</p>
  </div>
<% else %>
  <%
    team_h = ->(t) { t && { id: t.id, name: t.name, flag: t.flag_url } }
    preds = quiniela.match_predictions.index_by(&:match_id)
    bracket_data = matches.map do |m|
      mp = preds[m.id]
      {
        slot: m.bracket_slot, n: m.match_number, phase: m.phase,
        advances_to: m.advances_to.presence,
        home: team_h.call(m.home_team), away: team_h.call(m.away_team),
        home_label: m.home_label, away_label: m.away_label,
        pred_home: mp&.pred_home, pred_away: mp&.pred_away,
        penalty_qualifier_id: mp&.penalty_qualifier_id,
        real_home: m.home_goals, real_away: m.away_goals,
        penalty_winner_id: m.penalty_winner_id,
        status: m.status, finished: m.finished?
      }
    end

    # Build the bracket tree from the "Gan. N" labels so we can split it into a
    # left and right half that converge on the final.
    by_slot = matches.index_by(&:bracket_slot)
    by_num  = matches.index_by(&:match_number)
    child_of = ->(m, side) do
      lbl = side == :home ? m.home_label : m.away_label
      n = lbl.to_s[/Gan\.\s*(\d+)/, 1]
      n && by_num[n.to_i]
    end
    walk = nil
    walk = ->(m, depth, acc) do
      return if m.nil?
      (acc[depth] ||= []) << m
      walk.call(child_of.call(m, :home), depth + 1, acc)
      walk.call(child_of.call(m, :away), depth + 1, acc)
    end
    final_m = by_slot["M104"]
    third_m = by_slot["M103"]
    left_acc = {}; walk.call(child_of.call(final_m, :home), 0, left_acc)   # subtree feeding the final's home (M101)
    right_acc = {}; walk.call(child_of.call(final_m, :away), 0, right_acc) # ...away (M102)
    # Left half: leaves (R32) first → root (semi) last. Right half mirrored.
    left_cols  = left_acc.keys.sort.reverse.map { |d| left_acc[d] }
    right_cols = right_acc.keys.sort.map { |d| right_acc[d] }
    round_name = ->(m) { t("phase.#{m.phase}", default: m.phase) }
    col_header = ->(label) { tag.h3 label, class: "font-display text-[11px] font-extrabold uppercase tracking-wider text-white/55 text-center mb-2 whitespace-nowrap" }
  %>

  <div data-controller="bracket" data-action="input->bracket#recalc change->bracket#recalc">
    <script type="application/json" data-bracket-target="data"><%= raw bracket_data.to_json %></script>

    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <div class="surface px-3 py-1.5 inline-flex items-center gap-2 text-sm">
          <%= icon "trophy", class: "size-4 text-gold" %>
          <span class="text-white/60"><span data-bracket-target="championLabel">Tu campeón</span>:</span>
          <span data-bracket-target="champion" class="font-display font-extrabold text-gold">—</span>
        </div>
        <%# Mi pronóstico ⇄ Real %>
        <div class="surface inline-flex p-0.5 text-xs font-bold">
          <button type="button" data-action="bracket#showMine" data-bracket-target="modeMine"
                  class="px-2.5 py-1 rounded-md bg-gold text-pitch-900">Mi pronóstico</button>
          <button type="button" data-action="bracket#showReal" data-bracket-target="modeReal"
                  class="px-2.5 py-1 rounded-md text-white/70">Real</button>
        </div>
      </div>
      <div class="inline-flex items-center gap-1 surface px-1.5 py-1">
        <button type="button" data-action="bracket#zoomOut" aria-label="Alejar" class="w-7 h-7 rounded-lg bg-white/10 hover:bg-white/20 text-white text-lg font-bold leading-none cursor-pointer">−</button>
        <button type="button" data-action="bracket#zoomFit" class="px-2 h-7 rounded-lg bg-white/10 hover:bg-white/20 text-white text-xs font-bold cursor-pointer">Ajustar</button>
        <button type="button" data-action="bracket#zoomIn" aria-label="Acercar" class="w-7 h-7 rounded-lg bg-white/10 hover:bg-white/20 text-white text-lg font-bold leading-none cursor-pointer">+</button>
        <span data-bracket-target="zoomLabel" class="text-white/45 text-[11px] tabular-nums w-9 text-center">100%</span>
      </div>
    </div>

    <%# full-bleed map-like canvas: on phones it's a bounded pan/pinch surface,
        on desktop it fits to width. touch-action lets one finger pan natively
        while the controller handles two-finger pinch. %>
    <div class="w-screen relative left-1/2 -translate-x-1/2 overflow-auto px-3 pt-1 pb-6 max-h-[calc(100dvh-22rem)] sm:max-h-none overscroll-contain sm:overscroll-auto [touch-action:pan-x_pan-y]" data-bracket-target="scroller">
      <div class="relative flex items-stretch gap-2 sm:gap-3 min-w-max mx-auto w-fit origin-top-left" data-bracket-target="stage">
        <svg data-bracket-target="links" class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-visible" preserveAspectRatio="none" aria-hidden="true"></svg>

        <%# ---- LEFT HALF: R32 → R16 → QF → SF (left to centre) ---- %>
        <% left_cols.each do |col| %>
          <div class="flex flex-col w-[156px] sm:w-[172px] shrink-0">
            <%= col_header.call(round_name.call(col.first)) %>
            <%# each match takes an equal vertical share and centres in it, so a
                round-N+1 card lands exactly at the midpoint of its two feeders %>
            <div class="flex-1 flex flex-col">
              <% col.each do |m| %>
                <div class="flex-1 flex items-center">
                  <%= render "bracket_node", m: m, mp: preds[m.id], open: open, mirror: false %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ---- CENTRE: Final (finalists clash) + third place ---- %>
        <div class="flex flex-col justify-center items-center gap-4 w-[176px] sm:w-[188px] shrink-0 px-1">
          <div class="w-full">
            <%= col_header.call("🏆 #{round_name.call(final_m)}") %>
            <div class="ring-1 ring-gold/40 rounded-2xl p-0.5 bg-gold/5">
              <%= render "bracket_node", m: final_m, mp: preds[final_m.id], open: open, mirror: false %>
            </div>
          </div>
          <% if third_m %>
            <div class="w-full">
              <%= col_header.call(round_name.call(third_m)) %>
              <%= render "bracket_node", m: third_m, mp: preds[third_m.id], open: open, mirror: false %>
            </div>
          <% end %>
        </div>

        <%# ---- RIGHT HALF: SF → QF → R16 → R32 (centre to right, mirrored) ---- %>
        <% right_cols.each do |col| %>
          <div class="flex flex-col w-[156px] sm:w-[172px] shrink-0">
            <%= col_header.call(round_name.call(col.first)) %>
            <div class="flex-1 flex flex-col">
              <% col.each do |m| %>
                <div class="flex-1 flex items-center">
                  <%= render "bracket_node", m: m, mp: preds[m.id], open: open, mirror: true %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>
    </div>
    <p class="text-white/35 text-xs text-center mt-1">
      <span class="sm:hidden">Arrastra para moverte, pellizca para acercar, o usa <strong class="text-white/60">+ / −</strong>.</span>
      <span class="hidden sm:inline">Usa <strong class="text-white/60">+ / −</strong> para acercar y <strong class="text-white/60">Ajustar</strong> para ver todo el cuadro.</span>
    </p>
  </div>
<% end %>
