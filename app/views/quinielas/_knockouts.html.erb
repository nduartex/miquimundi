<% phase_styles = {
     "round_32"    => "bg-slate-200 text-slate-900",
     "round_16"    => "bg-sky-200 text-slate-900",
     "quarter"     => "bg-sky-300 text-slate-900",
     "semi"        => "bg-violet-300 text-slate-900",
     "third_place" => "bg-orange-200 text-slate-900",
     "final"       => "bg-amber-300 text-slate-900"
   } %>
<% by_phase = matches.group_by(&:phase) %>
<% preds = quiniela.match_predictions.index_by(&:match_id) %>
<p class="text-white/70 mb-5">Predice el <strong class="text-white">marcador exacto</strong> de cada llave. Sigue el orden del bracket: Dieciseisavos → Final. Las fases avanzadas multiplican tus puntos.</p>

<div class="space-y-8">
  <% Match::KNOCKOUT_ORDER.each do |phase| %>
    <% round_matches = by_phase[phase] %>
    <% next if round_matches.blank? %>
    <section>
      <div class="flex items-center gap-3 mb-3">
        <h3 class="font-display text-2xl font-extrabold text-white"><%= t("phase.#{phase}", default: phase) %></h3>
        <span class="h-px flex-1 bg-white/15"></span>
        <span class="text-white/50 text-sm font-semibold"><%= round_matches.size %> <%= "partido".pluralize(round_matches.size) %></span>
      </div>

      <div class="space-y-3">
        <% round_matches.each do |match| %>
          <% mult = match.multiplier %>
          <% home = match.home_team&.label || match.home_label || match.bracket_slot %>
          <% away = match.away_team&.label || match.away_label %>
          <div class="surface p-4">
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wide <%= phase_styles[match.phase] %>">
                Partido <%= match.match_number %>
              </span>
              <% if mult > 1.0 %>
                <span class="px-2 py-0.5 rounded-full text-xs font-extrabold bg-rose-500/90 text-white">×<%= mult.to_s.sub(/\.0$/, "") %> puntos</span>
              <% end %>
            </div>

            <div class="flex items-center justify-between gap-2">
              <div class="flex-1 min-w-0 text-white font-semibold truncate text-center sm:text-left">
                <%= home %>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                <div class="flex items-center gap-1" data-controller="stepper">
                  <button type="button" data-action="stepper#dec" aria-label="Menos" <%= "disabled" if match.locked? %>
                          class="w-11 h-11 rounded-xl bg-white/10 hover:bg-white/20 text-white text-2xl font-bold leading-none transition cursor-pointer disabled:opacity-40">−</button>
                  <%= number_field_tag "match_predictions[#{match.id}][pred_home]", preds[match.id]&.pred_home,
                        min: 0, inputmode: "numeric", data: { stepper_target: "input" }, disabled: match.locked?,
                        class: "w-14 h-11 rounded-xl bg-slate-800 border border-white/20 text-white text-2xl font-extrabold text-center tabular-nums focus:outline-none focus:ring-4 focus:ring-amber-300/60" %>
                  <button type="button" data-action="stepper#inc" aria-label="Más" <%= "disabled" if match.locked? %>
                          class="w-11 h-11 rounded-xl bg-white/10 hover:bg-white/20 text-white text-2xl font-bold leading-none transition cursor-pointer disabled:opacity-40">+</button>
                </div>

                <span class="text-white/50 font-display text-lg px-1">vs</span>

                <div class="flex items-center gap-1" data-controller="stepper">
                  <button type="button" data-action="stepper#dec" aria-label="Menos" <%= "disabled" if match.locked? %>
                          class="w-11 h-11 rounded-xl bg-white/10 hover:bg-white/20 text-white text-2xl font-bold leading-none transition cursor-pointer disabled:opacity-40">−</button>
                  <%= number_field_tag "match_predictions[#{match.id}][pred_away]", preds[match.id]&.pred_away,
                        min: 0, inputmode: "numeric", data: { stepper_target: "input" }, disabled: match.locked?,
                        class: "w-14 h-11 rounded-xl bg-slate-800 border border-white/20 text-white text-2xl font-extrabold text-center tabular-nums focus:outline-none focus:ring-4 focus:ring-amber-300/60" %>
                  <button type="button" data-action="stepper#inc" aria-label="Más" <%= "disabled" if match.locked? %>
                          class="w-11 h-11 rounded-xl bg-white/10 hover:bg-white/20 text-white text-2xl font-bold leading-none transition cursor-pointer disabled:opacity-40">+</button>
                </div>
              </div>

              <div class="flex-1 min-w-0 text-white font-semibold truncate text-center sm:text-right">
                <%= away %>
              </div>
            </div>

            <% if match.advances_to.present? %>
              <p class="text-white/40 text-xs mt-3 text-center">↳ El ganador avanza al partido <%= match.advances_to.delete("M") %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
