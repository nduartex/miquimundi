<div class="surface p-6">
  <h3 class="font-display text-2xl font-bold text-white mb-1">🏆 Premios individuales</h3>
  <p class="text-white/60 text-sm mb-5">Elígelos desde ya. Cada acierto suma <strong class="text-amber-300">10 puntos</strong>.</p>
  <label class="block text-white/70 text-xs uppercase tracking-wide mb-1">Goleador del Mundial</label>
  <%= select_tag "award_prediction[top_scorer_player_id]",
        options_from_collection_for_select(players, :id, :label, quiniela.award_prediction&.top_scorer_player_id),
        include_blank: "Selecciona…", class: "field mb-4" %>
  <label class="block text-white/70 text-xs uppercase tracking-wide mb-1">Máximo asistidor</label>
  <%= select_tag "award_prediction[top_assists_player_id]",
        options_from_collection_for_select(players, :id, :label, quiniela.award_prediction&.top_assists_player_id),
        include_blank: "Selecciona…", class: "field" %>
</div>
