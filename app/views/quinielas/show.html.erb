<% tp = thirds_payload(@tournament) %>
<div class="max-w-3xl mx-auto px-4 py-8"
     data-controller="wizard confetti tour"
     data-tour-name-value="mi-quiniela"
     data-tour-auto-value="<%= current_user.onboarded_at.nil? %>"
     data-tour-mark-url-value="<%= onboarding_path %>"
     data-tour-steps-value="<%= [
       { el: '#stat-puntos',  title: 'Puntos',  body: 'Tu puntaje total acumulado. Suma según tus aciertos en grupos, terceros, premios y eliminatorias.' },
       { el: '#stat-exactos', title: 'Exactos', body: 'Marcadores que clavaste exactos (resultado idéntico). Valen más puntos.' },
       { el: '#stat-aciertos', title: 'Aciertos', body: 'Partidos donde acertaste al ganador, aunque el marcador no sea exacto.' },
       { el: '#wizard-steps', title: 'Arma tu quiniela', body: 'Paso 1 Grupos → Paso 2 los 8 mejores terceros → Paso 3 Premios. Las Eliminatorias se abren al terminar la fase de grupos. Guarda para registrar tu jugada.' }
     ].to_json %>">

  <header class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-2">
      <h1 class="text-4xl font-extrabold text-white">Mi Quiniela</h1>
      <button type="button" data-action="tour#restart" title="Ver tutorial"
              class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 text-white/80 text-sm font-bold transition cursor-pointer">?</button>
    </div>
    <div class="text-amber-300 font-extrabold text-3xl font-display tabular-nums"><%= @quiniela.total_points %> <span class="text-lg align-top">pts</span></div>
  </header>

  <%= render "summary", quiniela: @quiniela %>

  <% if @groups_locked %>
    <div class="surface bg-rose-500/15 border-rose-300/30 p-3 mb-6 text-center text-rose-100 text-sm font-semibold">
      🔒 Tu quiniela de grupos quedó cerrada — el Mundial ya comenzó. Ya no se puede modificar.
    </div>
  <% end %>

  <!-- Step indicator -->
  <nav id="wizard-steps" class="grid grid-cols-4 gap-2 mb-6" aria-label="Pasos de la quiniela">
    <% [["Grupos", "①"], ["Terceros", "②"], ["Premios", "③"], [@knockout_open ? "Eliminatorias" : "Eliminatorias 🔒", "④"]].each_with_index do |(name, num), i| %>
      <button type="button" data-action="wizard#go" data-wizard-step-param="<%= i %>"
              data-wizard-target="tab"
              class="group flex flex-col items-center gap-1 py-3 rounded-xl border border-white/15 bg-slate-900/50 text-white/70 font-semibold transition hover:bg-white/10 cursor-pointer aria-[current=true]:bg-amber-400 aria-[current=true]:text-slate-900 aria-[current=true]:border-amber-300">
        <span class="text-lg font-display"><%= num %></span>
        <span class="text-xs sm:text-sm text-center leading-tight"><%= name %></span>
      </button>
    <% end %>
  </nav>

  <%= form_with url: quiniela_predictions_path, method: :post, data: { action: "submit->confetti#burst" } do %>
    <div class="wizard-panel" data-wizard-target="panel">
      <%= render "group_stage", groups: @groups, quiniela: @quiniela, locked: @groups_locked %>
    </div>
    <div class="wizard-panel" data-wizard-target="panel" hidden>
      <%= render "thirds", groups: @groups, quiniela: @quiniela, locked: @groups_locked, teams_json: tp[:teams].to_json, groups_json: tp[:groups].to_json %>
    </div>
    <div class="wizard-panel" data-wizard-target="panel" hidden>
      <%= render "awards", players: @players, teams: @teams, quiniela: @quiniela, locked: @groups_locked %>
    </div>
    <div class="wizard-panel" data-wizard-target="panel" hidden>
      <%= render "knockouts", matches: @knockouts, quiniela: @quiniela, open: @knockout_open %>
    </div>

    <div class="mt-8 flex items-center justify-between gap-3">
      <button type="button" data-action="wizard#prev" data-wizard-target="back"
              class="px-5 py-3 rounded-xl bg-white/10 text-white font-semibold border border-white/15 hover:bg-white/20 transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
        ← Atrás
      </button>
      <button type="button" data-action="wizard#next" data-wizard-target="forward"
              class="px-5 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold transition cursor-pointer">
        Siguiente →
      </button>
      <%= submit_tag "Guardar mi Quiniela",
            data: { wizard_target: "submit" },
            class: "flex-1 px-5 py-3 rounded-xl bg-gradient-to-r from-amber-400 to-rose-500 text-slate-900 font-extrabold text-lg hover:brightness-110 transition cursor-pointer" %>
    </div>
  <% end %>
</div>
