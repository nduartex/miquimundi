<% tp = thirds_payload(@tournament) %>
<div class="max-w-3xl mx-auto px-4 py-8"
     data-controller="wizard confetti tour"
     data-tour-name-value="mi-quiniela"
     data-tour-auto-value="<%= current_user.onboarded_at.nil? %>"
     data-tour-mark-url-value="<%= onboarding_path %>"
     data-tour-steps-value="<%= [
       { el: '#stat-puntos',  title: 'Puntos',  body: 'Tu puntaje total acumulado. Suma según tus aciertos en grupos, terceros, premios y eliminatorias.' },
       { el: '#stat-exactos', title: 'Exactos', body: 'Marcadores que clavaste exactos (resultado idéntico). Valen más puntos.' },
       { el: '#stat-aciertos', title: 'Aciertos', body: 'Partidos donde acertaste al ganador, aunque el marcador no sea exacto.' },
       { el: '#wizard-steps', title: 'Arma tu quiniela', body: 'Paso 1 Grupos → Paso 2 los 8 mejores terceros → Paso 3 Premios. Las Eliminatorias se abren al terminar la fase de grupos. Guarda para registrar tu jugada.' },
       { el: '#nav-ligas', title: 'Ligas', body: 'Compite en privado: crea una liga o únete con un código para enfrentarte solo a tu grupo de amigos y ver su ranking aparte.' },
       { el: '#nav-calendario', title: 'Calendario', body: 'Consulta todos los partidos del Mundial con sus fechas y horarios para no perderte ninguna jornada.' },
       { el: '#nav-discord', title: 'Discord', body: 'Únete a nuestra comunidad en Discord: ahí puedes reportar problemas, pedir soporte y comentar los partidos con los demás quinielistas.' },
       { el: '#access-link', title: '🔑 ¡GUARDA tu enlace!', body: 'Este es tu ÚNICO acceso. Cópialo y guárdalo en un lugar seguro: si se cierra la sesión, solo entras con este enlace. Si lo pierdes, pierdes tu quiniela (tu usuario por sí solo no sirve para reingresar).' }
     ].to_json %>">

  <header class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-2">
      <h1 class="text-4xl font-extrabold text-white">Mi Quiniela</h1>
      <button type="button" data-action="tour#restart" title="Ver tutorial"
              class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 text-white/80 text-sm font-bold transition cursor-pointer">?</button>
    </div>
    <div class="flex items-center gap-2" data-controller="modal">
      <div class="text-amber-300 font-extrabold text-3xl font-display tabular-nums"><%= @quiniela.total_points %> <span class="text-lg align-top">pts</span></div>
      <button type="button" data-action="modal#open" title="¿Cómo se calculan los puntos?"
              class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 text-white/80 text-sm font-bold transition cursor-pointer shrink-0">?</button>

      <div data-modal-target="panel" data-action="click->modal#backdrop"
           class="hidden fixed inset-0 z-[1100] flex items-center justify-center p-4 bg-pitch-900/80 backdrop-blur-sm"
           role="dialog" aria-modal="true" aria-labelledby="puntos-title">
        <div class="surface surface-neon max-w-lg w-full p-6 text-left max-h-[85vh] overflow-y-auto hero-in">
          <div class="flex items-center justify-between mb-4">
            <h2 id="puntos-title" class="font-display font-extrabold text-2xl text-gold uppercase tracking-wide flex items-center gap-2"><%= icon "calculator", class: "size-6" %> Cómo se cuentan los puntos</h2>
            <button type="button" data-action="modal#close" aria-label="Cerrar"
                    class="text-white/55 hover:text-white text-3xl leading-none cursor-pointer shrink-0">&times;</button>
          </div>

          <div class="space-y-5 text-sm text-white/85 leading-relaxed">
            <section>
              <h3 class="font-display font-bold text-white uppercase tracking-wide text-xs mb-1">① Fase de grupos</h3>
              <ul class="space-y-1 text-white/75">
                <li><span class="text-emerald-300 font-bold">+3</span> por cada equipo que clasifique (1º o 2º) que hayas acertado — hasta <span class="text-emerald-300 font-bold">+6</span> por grupo.</li>
                <li><span class="text-emerald-300 font-bold">+2</span> extra si además acertás el <strong class="text-white">orden exacto</strong> (1º y 2º en su lugar).</li>
              </ul>
            </section>

            <section>
              <h3 class="font-display font-bold text-white uppercase tracking-wide text-xs mb-1">② Mejores terceros</h3>
              <p class="text-white/75"><span class="text-emerald-300 font-bold">+3</span> por cada tercero que elijas y que realmente quede entre los 8 mejores terceros del Mundial.</p>
            </section>

            <section>
              <h3 class="font-display font-bold text-white uppercase tracking-wide text-xs mb-1">③ Premios</h3>
              <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-white/75">
                <li>Balón de Oro <span class="text-gold font-bold float-right">+10</span></li>
                <li>Bota de Oro <span class="text-gold font-bold float-right">+10</span></li>
                <li>Guante de Oro <span class="text-gold font-bold float-right">+8</span></li>
                <li>Mejor joven <span class="text-gold font-bold float-right">+6</span></li>
                <li>Fair Play <span class="text-gold font-bold float-right">+5</span></li>
              </ul>
            </section>

            <section>
              <h3 class="font-display font-bold text-white uppercase tracking-wide text-xs mb-1">④ Partidos (grupos y eliminatorias)</h3>
              <ul class="space-y-1 text-white/75">
                <li><span class="text-emerald-300 font-bold">+5</span> marcador <strong class="text-white">exacto</strong> (cuenta como exacto <%= icon "check", class: "size-4 inline align-text-bottom text-emerald-300" %> y acierto <%= icon "goal", class: "size-4 inline align-text-bottom text-rose-300" %>).</li>
                <li><span class="text-emerald-300 font-bold">+2</span> si acertás solo el <strong class="text-white">ganador</strong> (no el marcador) — cuenta como acierto <%= icon "goal", class: "size-4 inline align-text-bottom text-rose-300" %>.</li>
                <li><span class="text-emerald-300 font-bold">+3</span> si acertás quién <strong class="text-white">avanza por penales</strong>.</li>
              </ul>
              <p class="mt-2 text-white/60 text-xs">Los puntos del partido se multiplican según la ronda:</p>
              <p class="mt-1 text-white/80 text-xs">
                32avos ×1 · 16avos ×1 · <span class="text-white">Cuartos ×1.5</span> · <span class="text-white">Semis ×2</span> · <span class="text-gold font-bold">Final ×3</span> · 3er puesto ×1
              </p>
            </section>
          </div>

          <button type="button" data-action="modal#close" class="btn-primary w-full mt-6">Entendido</button>
        </div>
      </div>
    </div>
  </header>

  <%= render "summary", quiniela: @quiniela %>

  <%= render "achievements", quiniela: @quiniela %>

  <div id="access-link" class="surface p-4 mb-6 <%= 'ring-2 ring-amber-300' if params[:welcome] %>" data-controller="clipboard">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-white font-bold inline-flex items-center gap-1.5"><%= icon "key", class: "size-5" %> Tu enlace de acceso</span>
      <span class="text-white/50 text-xs">guárdalo para volver a entrar si se cierra la sesión</span>
    </div>
    <div class="flex gap-2">
      <input type="text" readonly value="<%= restore_url(token: current_user.access_token) %>"
             data-clipboard-target="source" onclick="this.select()"
             class="field text-sm">
      <button type="button" data-action="clipboard#copy" data-clipboard-target="btn"
              class="px-4 rounded-xl bg-amber-400 text-slate-900 font-bold shrink-0 cursor-pointer">Copiar</button>
    </div>
    <% if params[:welcome] %>
      <p class="text-amber-200/90 text-xs mt-2 flex items-start gap-1.5"><%= icon "triangle-alert", class: "size-4 shrink-0 mt-0.5" %><span>Este enlace es tu única forma de reingresar. Si lo pierdes, pierdes el acceso a tu quiniela.</span></p>
    <% end %>
  </div>

  <%= render "shared/discord_banner" %>

  <% if @quiniela.submitted? %>
    <div class="surface p-4 mb-6" data-controller="share-card clipboard">
      <script type="application/json" data-share-card-target="data"><%== prediction_card_data(@quiniela).to_json %></script>

      <div class="flex items-center gap-2 mb-4">
        <span class="text-white font-bold inline-flex items-center gap-1.5"><%= icon "megaphone", class: "size-5" %> Comparte tu predicción</span>
        <span class="text-white/50 text-xs">elige según dónde estés</span>
      </div>

      <!-- Móvil: imagen para historias de IG / WhatsApp -->
      <div class="mb-4">
        <p class="text-white/85 text-sm font-semibold mb-2 inline-flex items-center gap-1.5"><%= icon "smartphone", class: "size-4" %> En el celular — para tus historias</p>
        <% if @quiniela.first_part_complete? %>
          <button type="button" data-action="share-card#share" class="btn-primary w-full">
            Compartir como imagen
          </button>
          <div data-share-card-target="preview" class="hidden mt-3 text-center">
            <img data-share-card-target="image"
                 class="mx-auto w-full max-w-[260px] rounded-2xl border border-emerald-200/20 shadow-lg"
                 alt="Mi predicción del Mundial">
            <a data-share-card-target="download" download="mi-prediccion-mundial.png"
               class="btn-ghost w-full mt-3"><%= icon "download", class: "size-5" %> Descargar</a>
            <p class="text-xs text-white/50 mt-2">Guárdala y subila a tu historia de IG o WhatsApp</p>
          </div>
        <% else %>
          <button type="button" disabled
                  class="btn-primary w-full opacity-50 cursor-not-allowed">
            Compartir como imagen
          </button>
          <p class="text-xs text-white/60 mt-2">
            Completá <%= @quiniela.first_part_missing.to_sentence %> para generar tu imagen.
          </p>
        <% end %>
      </div>

      <div class="border-t border-white/10 my-4"></div>

      <!-- Escritorio / web: enlace público de solo lectura -->
      <div>
        <p class="text-white/85 text-sm font-semibold mb-2 inline-flex items-center gap-1.5"><%= icon "link", class: "size-4" %> En la computadora — enlace para abrir en el navegador</p>
        <div class="flex gap-2">
          <input type="text" readonly value="<%= shared_quiniela_url(token: @quiniela.share_token) %>"
                 data-clipboard-target="source" onclick="this.select()"
                 class="field text-sm">
          <button type="button" data-action="clipboard#copy" data-clipboard-target="btn"
                  class="px-4 rounded-xl bg-sky-400 text-slate-900 font-bold shrink-0 cursor-pointer">Copiar</button>
        </div>
        <p class="text-xs text-white/50 mt-2">Solo lectura, sin tu puntaje.</p>
      </div>
    </div>
  <% end %>

  <% if @late_window %>
    <div class="surface bg-amber-400/15 border-amber-300/30 p-3 mb-6 text-amber-100 text-sm font-semibold flex items-center justify-center gap-2">
      <%= icon "clock", class: "size-4 shrink-0" %>
      <span>El Mundial ya comenzó, pero aún puedes llenar tu quiniela hasta el <%= l @tournament.late_deadline_at.in_time_zone, format: :late_deadline %> (hora de Chile). Tus puntos de grupos, terceros y premios valdrán <%= late_points_percent %>, y tienes un solo guardado.</span>
    </div>
  <% elsif @groups_locked %>
    <div class="surface bg-rose-500/15 border-rose-300/30 p-3 mb-6 text-rose-100 text-sm font-semibold flex items-center justify-center gap-2">
      <%= icon "lock", class: "size-4 shrink-0" %>
      <span>Tu quiniela de grupos quedó cerrada — el Mundial ya comenzó. Ya no se puede modificar.</span>
    </div>
  <% end %>

  <!-- Step indicator -->
  <nav id="wizard-steps" class="grid grid-cols-4 gap-2 mb-6 scroll-mt-20" aria-label="Pasos de la quiniela">
    <% steps = [
         { name: "Grupos",   num: "①", accent: "var(--color-grass)" },
         { name: "Terceros", num: "②", accent: "var(--color-sky)" },
         { name: "Premios",  num: "③", accent: "var(--color-gold)" },
         { name: "Eliminatorias", locked: !@knockout_open, num: "④", accent: "var(--color-rose)" }
       ] %>
    <% steps.each_with_index do |s, i| %>
      <button type="button" data-action="wizard#go" data-wizard-step-param="<%= i %>"
              data-wizard-target="tab" style="--accent: <%= s[:accent] %>" class="wz-tab">
        <span class="text-lg font-display"><%= s[:num] %></span>
        <span class="text-xs sm:text-sm text-center leading-tight inline-flex items-center gap-1"><%= s[:name] %><% if s[:locked] %><%= icon "lock", class: "size-3" %><% end %></span>
      </button>
    <% end %>
  </nav>

  <%= form_with url: quiniela_predictions_path, method: :post, data: {
        controller: "gate",
        gate_enforce_value: !@groups_locked,
        action: "submit->confetti#burst input->gate#refresh change->gate#refresh"
      } do %>
    <div class="wizard-panel" data-wizard-target="panel">
      <%= render "group_stage", groups: @groups, quiniela: @quiniela, locked: @groups_locked %>
    </div>
    <div class="wizard-panel" data-wizard-target="panel" hidden>
      <%= render "thirds", groups: @groups, quiniela: @quiniela, locked: @groups_locked, teams_json: tp[:teams].to_json, groups_json: tp[:groups].to_json %>
    </div>
    <div class="wizard-panel" data-wizard-target="panel" hidden>
      <%= render "awards", players: @players, teams: @teams, quiniela: @quiniela, locked: @groups_locked %>
    </div>
    <div class="wizard-panel" data-wizard-target="panel" hidden>
      <%= render "knockouts", matches: @knockouts, quiniela: @quiniela, open: @knockout_open %>
    </div>

    <p data-gate-target="status" hidden role="status"
       class="mt-6 text-center text-amber-200/90 text-sm font-semibold"></p>

    <%# Sticky action bar on phones so Guardar stays reachable even when a tall
        panel (the bracket) traps vertical scrolling. Normal flow on desktop. %>
    <div class="mt-8 flex items-center justify-between gap-3
                sticky bottom-0 z-30 -mx-4 px-4 py-3 bg-pitch-900/90 backdrop-blur border-t border-white/10
                sm:static sm:mx-0 sm:px-0 sm:py-0 sm:bg-transparent sm:backdrop-blur-none sm:border-0">
      <button type="button" data-action="wizard#prev" data-wizard-target="back" class="btn-ghost flex-1 font-extrabold uppercase tracking-wide whitespace-nowrap">
        ← Atrás
      </button>
      <button type="button" data-action="wizard#next" data-wizard-target="forward" class="btn-sky flex-1 whitespace-nowrap">
        Siguiente →
      </button>
      <%= button_tag type: "submit",
            data: { wizard_target: "submit", gate_target: "submit" },
            class: "btn-gold flex-1 whitespace-nowrap" do %><%= icon "trophy", class: "size-5" %> Guardar<% end %>
    </div>
  <% end %>

  <% if params[:fase1] %>
    <div data-controller="celebrate"
         class="fixed inset-0 z-[1100] flex items-center justify-center p-4 bg-pitch-900/80 backdrop-blur-sm"
         role="dialog" aria-modal="true" aria-labelledby="fase1-title">
      <div class="surface surface-neon max-w-md w-full p-7 text-center hero-in">
        <div class="mb-3 flex justify-center text-amber-300"><%= icon "party-popper", class: "size-14" %></div>
        <h2 id="fase1-title" class="font-poster text-3xl text-gold mb-2">¡FELICIDADES!</h2>
        <p class="text-white/85 leading-relaxed mb-1">Completaste la primera fase de tu quiniela.</p>
        <p class="text-white/70 leading-relaxed mb-6">Revisa <strong class="text-sky">Eliminatorias</strong> para ver cuándo se abre la segunda fase.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <button type="button" data-action="wizard#go celebrate#close" data-wizard-step-param="3" class="btn-sky flex-1">
            Ver Eliminatorias →
          </button>
          <button type="button" data-action="celebrate#close" class="btn-ghost flex-1">
            Cerrar
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <% if params[:logros].present? %>
    <% keys = params[:logros].to_s.split(",") %>
    <% epic = (keys & AchievementCatalog::EPIC_KEYS).any? %>
    <div data-controller="celebrate" data-celebrate-level-value="<%= epic ? 'epic' : 'normal' %>"
         class="fixed inset-x-0 top-4 z-[1100] flex justify-center px-4">
      <div class="surface surface-neon p-4 max-w-md w-full flex items-center gap-3 hero-in">
        <span class="text-3xl"><%= keys.map { |k| AchievementCatalog.find(k)&.emoji }.join %></span>
        <div class="flex-1 min-w-0">
          <div class="font-display font-extrabold text-gold uppercase tracking-wide">¡Logro desbloqueado!</div>
          <div class="text-white/85 text-sm truncate"><%= keys.map { |k| AchievementCatalog.find(k)&.name }.compact.join(" · ") %></div>
        </div>
        <button type="button" data-action="celebrate#close" aria-label="Cerrar"
                class="text-white/55 hover:text-white text-2xl leading-none cursor-pointer">&times;</button>
      </div>
    </div>
  <% end %>
</div>
